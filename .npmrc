# ---- Supply chain hardening ----
# 「どのパッケージが postinstall などのライフサイクルスクリプトを実行できるか」は
# package.json の pnpm.onlyBuiltDependencies で明示的に許可リストとして管理する。
# （pnpm v9.5+ で、未許可パッケージの install scripts はデフォルト無視される）

# ロックファイルとの差分があるインストールを警告/拒否しやすくする
prefer-frozen-lockfile=true

# pnpm の整合性検証（tarball ハッシュとストアの突き合わせ）
verify-store-integrity=true

# engines.node / engines.pnpm を厳格に検査（CI と開発機で Node バージョン揃える）
engine-strict=true

# 公開レジストリ以外への流出/混入を防ぐ
registry=https://registry.npmjs.org/

# pnpm audit / npm audit の閾値（高以上で失敗扱い）
audit-level=high

# ---- 公開直後パッケージの quarantine（典型的な悪性 publish 対策） ----
# レジストリ公開から 7 日 = 10080 分 未満のバージョンはインストールしない。
# 著名パッケージが乗っ取られて悪性版が publish された場合、おおむね数時間〜数日で
# 検知 → unpublish される傾向があるため、新規版の取り込みを猶予する。
# 値は「分」単位。pnpm v10.16+ で有効。
minimum-release-age=10080

# quarantine の例外（自社/信頼スコープを即時取り込みたい場合のみ列挙）。
# 例: minimum-release-age-exclude=@my-org/*,@types/*
minimum-release-age-exclude=
