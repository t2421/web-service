# =====================================================================
# Application
# =====================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Database (PostgreSQL)
# Local: docker compose up -d で起動するローカルDB
# Prod : Neon / Supabase / RDS などの接続文字列を入れる
# =====================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# =====================================================================
# Redis (Upstash 互換 REST API)
# ローカル: docker の redis を使う場合は UPSTASH_*** を空にし、
#          src/lib/redis.ts が ioredis フォールバックする想定。
# 本番   : Upstash の REST URL/Token を設定。
# =====================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =====================================================================
# Auth.js (NextAuth v5)
# AUTH_SECRET は `openssl rand -base64 32` で生成
# =====================================================================
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OAuth Providers (任意で有効化)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# =====================================================================
# Stripe
# =====================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=

# =====================================================================
# Resend (Email)
# =====================================================================
RESEND_API_KEY=
EMAIL_FROM="App <noreply@example.com>"

# =====================================================================
# Sentry
# =====================================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =====================================================================
# PostHog
# =====================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
